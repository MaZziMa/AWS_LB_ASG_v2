# Frontend -> Backend wiring
#
# Option A (recommended for local dev): use Vite proxy.
# - Keep VITE_API_BASE_URL empty
# - Set VITE_API_PROXY_TARGET to your backend origin
#
# Local backend
# VITE_API_PROXY_TARGET=http://localhost:8000
#
# AWS backend (ALB)
# VITE_API_PROXY_TARGET=http://course-management-alb-dev-1530526851.us-east-1.elb.amazonaws.com

# Option B (direct browser calls, no proxy): set backend origin.
# This requires backend CORS to allow your frontend origin.
# VITE_API_BASE_URL=http://course-management-alb-dev-1530526851.us-east-1.elb.amazonaws.com
