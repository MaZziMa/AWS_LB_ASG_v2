# Environment Configuration Template
# Copy this to .env and fill in your values

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# DynamoDB Tables (will be created by Terraform)
COURSES_TABLE=course-management-courses-dev
STUDENTS_TABLE=course-management-students-dev
ENROLLMENTS_TABLE=course-management-enrollments-dev

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=*

# Terraform Backend (optional)
# TF_STATE_BUCKET=your-terraform-state-bucket
# TF_STATE_KEY=course-management/terraform.tfstate
# TF_STATE_REGION=us-east-1
